[
  {
    "id": "rv-1-1-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "I Laud Agni, the chosen Priest, God, minister of sacrifice,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "Worthy is Agni to be praised by living as by ancient seers.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "Through Agni man obtaineth wealth, yea, plenty waxing day by day,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "Agni, the perfect sacrifice which thou encompassest about",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "May Agni, sapient-minded Priest, truthful, most gloriously great,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "Whatever blessing, Agni, thou wilt grant unto thy worshipper,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "To thee, dispeller of the night, O Agni, day by day with prayer",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-8",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.8",
    "sanskrit": "",
    "transliteration": "",
    "english": "Ruler of sacrifices, guard of Law eternal, radiant One,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-1-9",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.1.9",
    "sanskrit": "",
    "transliteration": "",
    "english": "Be to us easy of approach, even as a father to his son:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "MAY powers auspicious come to us from every side, never deceived, unhindered, and victorious,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "May the auspicious favour of the Gods be ours, on us descend the bounty of the righteous Gods.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "We call them hither with a hymn of olden time, Bhaga, the friendly Dakṣa, Mitra, Aditi,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "May the Wind waft to us that pleasant medicine, may Earth our Mother give it, and our Father Heaven,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "Him we invoke for aid who reigns supreme, the Lord of all that stands or moves, inspirer of the soul,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "Illustrious far and wide, may Indra prosper us: may Pūṣan prosper us, the Master of all wealth.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "The Maruts, Sons of Pṛśni, borne by spotted steeds, moving in glory, oft visiting holy rites,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-8",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.8",
    "sanskrit": "",
    "transliteration": "",
    "english": "Gods, may we with our ears listen to what is good, and with our eyes see what is good, ye Holy Ones.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-9",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.9",
    "sanskrit": "",
    "transliteration": "",
    "english": "A hundred autumns stand before us, O ye Gods, within whose space ye bring our bodies to decay;",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-89-10",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.89.10",
    "sanskrit": "",
    "transliteration": "",
    "english": "Aditi is the heaven, Aditi is mid-air, Aditi is the Mother and the Sire and Son.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "MAY Varuṇa with guidance straight, and Mitra lead us, he who knows,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "For they are dealers forth of wealth, and, not deluded, with their might",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "Shelter may they vouchsafe to us, Immortal Gods to mortal men,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "May they mark out our paths to bliss, Indra, the Maruts, Pūṣan,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "Yea, Pūṣan, Viṣṇu, ye who run your course, enrich our hymns with kine;",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "The winds waft sweets, the rivers pour sweets for the man who keeps the Law",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "Sweet be the night and sweet the dawns, sweet the terrestrial atmosphere;",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-8",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.8",
    "sanskrit": "",
    "transliteration": "",
    "english": "May the tall tree be full of sweets for us, and full of sweets the Sun:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-1-90-9",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 1,
    "verse": "1.90.9",
    "sanskrit": "",
    "transliteration": "",
    "english": "Be Mitra gracious unto us, and Varuṇa and Aryaman:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "YOUR well-known prompt activities aforetime needed no impulse from your faithful servant.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "This man, most diligent, seeking after riches, incessantly invokes you for your favour.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "O Indra-Varuṇa, ours be this treasure ours be wealth, Maruts, with full store of heroes.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "Be pleased! with our oblations, thou loved of all Gods, Bṛhaspati:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "At sacrifices, with your hymns worship the pure Bṛhaspati—",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "The Bull of men, whom none deceive, the wearer of each shape at will,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "Divine, resplendent Pūṣan, this our newest hymn of eulogy,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-8",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.8",
    "sanskrit": "",
    "transliteration": "",
    "english": "Accept with favour this my song, be gracious to the earnest thought,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-9",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.9",
    "sanskrit": "",
    "transliteration": "",
    "english": "May he who sees all living things, see, them together at a glance,—",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-10",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.10",
    "sanskrit": "",
    "transliteration": "",
    "english": "May we attain that excellent glory of Savitar the God:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-11",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.11",
    "sanskrit": "",
    "transliteration": "",
    "english": "With understanding, earnestly, of Savitar the God we crave",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-12",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.12",
    "sanskrit": "",
    "transliteration": "",
    "english": "Men, singers worship Savitar the God with hymn and holy rites,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-13",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.13",
    "sanskrit": "",
    "transliteration": "",
    "english": "Soma who gives success goes forth, goes to the gathering place of Gods,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-14",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.14",
    "sanskrit": "",
    "transliteration": "",
    "english": "To us and to our cattle may Soma give salutary food,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-15",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.15",
    "sanskrit": "",
    "transliteration": "",
    "english": "May Soma, strengthening our power of life, and conquering our foes,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-16",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.16",
    "sanskrit": "",
    "transliteration": "",
    "english": "May Mitra-Varuṇa, sapient Pair, bedew our pasturage with oil,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-17",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.17",
    "sanskrit": "",
    "transliteration": "",
    "english": "Far-ruling, joyful when adored, ye reign through majesty of might,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-3-62-18",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 3,
    "verse": "3.62.18",
    "sanskrit": "",
    "transliteration": "",
    "english": "Lauded by Jamadagni's song, sit in the place of holy Law:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-7-89-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 7,
    "verse": "7.89.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "LET me not yet, King Varuṇa, enter into the house of clay:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-7-89-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 7,
    "verse": "7.89.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "When, Thunderer! I move along tremulous like a wind-blown skin,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-7-89-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 7,
    "verse": "7.89.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "O Bright and Powerful God, through want of strength I erred and went astray",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-7-89-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 7,
    "verse": "7.89.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "Thirst found thy worshipper though he stood in the midst of water-fijods:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-7-89-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 7,
    "verse": "7.89.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "O Varuṇa, whatever the offence may be which we as men commit against the heavenly host,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "A THOUSAND heads hath Puruṣa, a thousand eyes, a thousand feet.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "This Puruṣa is all that yet hath been and all that is to be;",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "So mighty is his greatness; yea, greater than this is Puruṣa.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "With three-fourths Puruṣa went up: one-fourth of him again was here.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "From him Virāj was born; again Puruṣa from Virāj was born.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "When Gods prepared the sacrifice with Puruṣa as their offering,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "They balmed as victim on the grass Puruṣa born in earliest time.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-8",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.8",
    "sanskrit": "",
    "transliteration": "",
    "english": "From that great general sacrifice the dripping fat was gathered up.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-9",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.9",
    "sanskrit": "",
    "transliteration": "",
    "english": "From that great general sacrifice Ṛcas and Sāma-hymns were born:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-10",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.10",
    "sanskrit": "",
    "transliteration": "",
    "english": "From it were horses born, from it all cattle with two rows of teeth:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-11",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.11",
    "sanskrit": "",
    "transliteration": "",
    "english": "When they divided Puruṣa how many portions did they make?",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-12",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.12",
    "sanskrit": "",
    "transliteration": "",
    "english": "The Brahman was his mouth, of both his arms was the Rājanya made.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-13",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.13",
    "sanskrit": "",
    "transliteration": "",
    "english": "The Moon was gendered from his mind, and from his eye the Sun had birth;",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-14",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.14",
    "sanskrit": "",
    "transliteration": "",
    "english": "Forth from his navel came mid-air the sky was fashioned from his head",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-15",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.15",
    "sanskrit": "",
    "transliteration": "",
    "english": "Seven fencing-sticks had he, thrice seven layers of fuel were prepared,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-90-16",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.90.16",
    "sanskrit": "",
    "transliteration": "",
    "english": "Gods, sacrificing, sacrificed the victim these were the earliest holy ordinances.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "IN the beginning rose Hiranyagarbha, born Only Lord of all created beings.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "Giver of vital breath, of power and vigour, he whose commandments all the Gods acknowledge -.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "Who by his grandeur hath become Sole Ruler of all the moving world that breathes and slumbers;",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "His, through his might, are these snow-covered mountains, and men call sea and Rasā his possession:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "By him the heavens are strong and earth is stedfast, by him light's realm and sky-vault are supported:",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "To him, supported by his help, two armies embattled look while trembling in their spirit,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "What time the mighty waters came, containing the universal germ, producing Agni,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-8",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.8",
    "sanskrit": "",
    "transliteration": "",
    "english": "He in his might surveyed the floods containing productive force and generating Worship.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-9",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.9",
    "sanskrit": "",
    "transliteration": "",
    "english": "Neer may he harm us who is earth's Begetter, nor he whose laws are sure, the heavens' Creator,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-121-10",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.121.10",
    "sanskrit": "",
    "transliteration": "",
    "english": "Prajāpati! thou only comprehendest all these created things, and none beside thee.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "THEN was not non-existent nor existent: there was no realm of air, no sky beyond it.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "Death was not then, nor was there aught immortal: no sign was there, the day's and night's divider.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "Darkness there was: at first concealed in darkness this All was indiscriminated chaos.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "Thereafter rose Desire in the beginning, Desire, the primal seed and germ of Spirit.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-5",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.5",
    "sanskrit": "",
    "transliteration": "",
    "english": "Transversely was their severing line extended: what was above it then, and what below it?",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-6",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.6",
    "sanskrit": "",
    "transliteration": "",
    "english": "Who verily knows and who can here declare it, whence it was born and whence comes this creation?",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-129-7",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.129.7",
    "sanskrit": "",
    "transliteration": "",
    "english": "He, the first origin of this creation, whether he formed it all or did not form it,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-191-1",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.191.1",
    "sanskrit": "",
    "transliteration": "",
    "english": "THOU, mighty Agni, gatherest up all that is precious for thy friend.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-191-2",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.191.2",
    "sanskrit": "",
    "transliteration": "",
    "english": "Assemble, speak together: let your minds be all of one accord,",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-191-3",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.191.3",
    "sanskrit": "",
    "transliteration": "",
    "english": "The place is common, common the assembly, common the mind, so be their thought united.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  },
  {
    "id": "rv-10-191-4",
    "source": "Rig Veda",
    "source_short": "RV",
    "category": "Rig Veda",
    "chapter": 10,
    "verse": "10.191.4",
    "sanskrit": "",
    "transliteration": "",
    "english": "One and the same be your resolve, and be your minds of one accord.",
    "hindi": "",
    "speaker": "",
    "wordMeanings": ""
  }
]